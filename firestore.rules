rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin';
    }

    // User profiles
    match /users/{userId} {
      // A user can read only their own profile; admins can read all (admin dashboard)
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      // New accounts can only create their own profile as a normal 'user'
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.get('role', 'user') == 'user';

      // Users can edit their own profile but can NEVER change their role.
      // Older profiles with no 'role' field are treated as 'user'.
      // Only admins can change roles.
      allow update: if isSignedIn()
        && ((request.auth.uid == userId
              && request.resource.data.get('role', 'user') == resource.data.get('role', 'user'))
            || isAdmin());

      allow delete: if isAdmin();
    }

    // Shows & movies catalog: public read, admin write
    match /shows/{showId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Collections: public read, admin write
    match /collections/{colId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Comments
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn()
        && (request.auth.uid == resource.data.userId || isAdmin());
    }
  }
}
