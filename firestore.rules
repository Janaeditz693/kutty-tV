rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profiles Rules
    match /users/{userId} {
      // Any authenticated user can read profiles (needed for admin view and profile checks)
      // and write their own profile document
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
    
    // Shows & Movies Catalog Rules
    match /shows/{showId} {
      // Anyone (even guests) can view the shows catalog
      allow read: if true;
      // Only authenticated admins can write/edit the catalog
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Collections Rules
    match /collections/{colId} {
      allow read: if true;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Comments Rules
    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (request.auth.uid == resource.data.userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
  }
}
